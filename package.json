{
  "name": "accessibility-testing-with-cypress",
  "description": "Accessibility testing with Cypress and axe-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "npm run start:copy-report-data && craco start",
    "start:remote": "npx dotenv-cli -e .env.production.local -- craco start",
    "build": "craco build",
    "test": "craco test",
    "deploy": "gh-pages -d build -b gh-pages -e react-app",
    "cypress:open": "cypress open",
    "cypress:moda": "cross-env CYPRESS_BASE_URL=https://moda.gov.tw cypress open",
    "cypress:site": "cross-env CYPRESS_BASE_URL=https://if540.github.io/accessibility-testing-with-cypress/react-app cypress open",
    "cypress:local": "cross-env CYPRESS_BASE_URL=http://localhost:3000 cypress open",
    "start:copy-report-data": "xcopy cypress\\reports public\\a11y-reports\\ /E /Y"
  },
  "homepage": "https://if540.github.io/accessibility-testing-with-cypress/react-app",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "env": {
      "cypress/globals": true
    },
    "plugins": [
      "cypress"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.10",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.8.2",
    "react-scripts": "5.0.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@shadcn/ui": "^0.0.4",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/cypress": "^0.1.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.11.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^7.4.2",
    "cypress": "^15.6.0",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "cypress-wait-until": "^3.0.2",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-react": "7.37.5",
    "gh-pages": "^6.3.0",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
